{
  "name": "ionic-todo-categories",
  "version": "0.1.0",
  "author": "Luis Robles",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "android:run": "ionic cordova run android",
    "android:build": "ionic cordova build android",
    "android:release": "ionic cordova build android --prod --release -- -- --packageType=apk",
    "ios:run": "ionic cordova run ios --prod",
    "ios:build": "ionic cordova build ios --prod",
    "cordova:requirements": "cordova requirements"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ionic/angular": "^9.0.0",
    "@ionic/storage": "^4.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@ionic/cordova-builders": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.6.0",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "prettier": "@ionic/prettier-config",
  "description": "To-Do app con categorías construida con Ionic, Angular y Cordova",
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {}
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
